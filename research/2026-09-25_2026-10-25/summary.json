  "reviewed_comments": 249,
  "findings": [
    {
      "category": "optimization",
      "title": "优先核实启动、着色器编译与活动切换的阻断问题",
      "observation": "15条不同文本自述崩溃、闪退、着色器编译卡住或显存不足，触发场景涉及启动、更新后编译、活动入口、抽取记录及切换3D。部分反馈提供了设备、系统或进度信息，其中有无法进入设置恢复的情况。它们支持建立阻断性问题验证清单，不证明15位独立玩家或同一个根因。",
      "recommendation": "先复现阻断游玩的路径，按图形后端、设备和入口分组；评估提供安全画质启动、图形设置重置及失败后的可恢复入口，避免用户只能重装。反馈入口自动携带版本、图形选项和错误日志，并清楚展示受理与修复状态。",
      "validation": "分别测试冷启动、着色器首次/重复编译、活动页面与3D切换；记录失败率、复现条件、恢复成功率和恢复步骤。对照日志确认问题，而非从评论中的显卡型号直接推断兼容性或内存根因。",
      "caveat": "15是已读文本中的具体报告数，非用户数、总体发生率或故障证明。未查看附图、采集设备日志或实际运行游戏，不能宣称某平台普遍不可用。",
      "evidence_count": 15,
      "source_count": 4,
      "source_urls": [
        "https://www.kurobbs.com/mc/post/1551620270882566144",
        "https://www.kurobbs.com/mc/post/1554788184571133952",
        "https://www.kurobbs.com/mc/post/1560268447163764736",
        "https://www.kurobbs.com/mc/post/1553219921630347264"
      ]
    },
    {
      "category": "optimization",
      "title": "讲清资源包、渲染档位与设备限制之间的关系",
      "observation": "6条不同文本明确询问资源包与光追/分辨率的关系、设备适合哪个档位、高清与极致差异、能否拆分贴图和过场资源，或为何设备只能选择特定预设。其中包含对当前表现的正面描述，不能全部算作负面评价。",
      "recommendation": "在下载选择页用对照表分别说明资源内容、占用、可用画质与设备限制；将“下载什么资源”和“运行什么渲染设置”分开解释。提供预览、剩余空间提示与可逆切换说明，评估贴图和过场资源分项选择。",
      "validation": "让不同配置的新老玩家完成包体选择任务，检查能否正确解释包体、画质和运行表现的关系，记录选择理由、错误理解和后续切换路径；再验证分项下载的可行性。",
      "caveat": "6条都来自同一资源分级说明帖，反映该讨论场景内的信息需求，不足以估算全部玩家的理解困难，也不证明现有说明完全缺失。",
      "evidence_count": 6,
      "source_count": 1,
      "source_urls": [
        "https://www.kurobbs.com/mc/post/1552747271999410176"
      ]
    },
    {
      "category": "optimization",
      "title": "建立按平台和场景拆分的性能与画面回归清单",
      "observation": "9条不同文本分别描述不同图形后端掉帧、战斗与活动页面帧率差异、移动端发热、进入游戏耗时、移动端出怪等待、更新后模糊、设备画质适配、严重卡顿及滤镜锐化问题。症状不同，不能汇总成一个已确认的“性能差”原因。",
      "recommendation": "将战斗、活动页面、加载/出怪和首进游戏分开测试；在平台、图形后端和画质档位下分别记录帧时间、等待时间与画面设置。对发热和耗电结合实际设备记录；视觉锐化、模糊和适配需求单列处理。",
      "validation": "建立同场景、同设置、同版本的对照任务，测量帧时间分布和卡顿尖峰，而非只看平均帧率；同时采集温度、加载等待及设置截图。用用户自述定位测试条件，不把出怪等待直接归因于网络。",
      "caveat": "9是已核查评论文本数，设备和场景差异大，未进行性能测量。反馈模板中的“网络环境”以及配队讨论中的“适配”不会被当作真实网络或设备故障证据。",
      "evidence_count": 9,
      "source_count": 3,
      "source_urls": [
        "https://www.kurobbs.com/mc/post/1554788184571133952",
        "https://www.kurobbs.com/mc/post/1552747271999410176",
        "https://www.kurobbs.com/mc/post/1560708863715774464"
      ]
    },
    {
      "category": "optimization",
      "title": "验证任务中途退出与传送后的恢复路径",
      "observation": "2条不同文本分别自述任务中途退出后被困，以及传送离开后无法继续任务。它们未命中现有主题词典，是未命中覆盖样本中发现的具体使用障碍。",
      "recommendation": "将中断、退出、传送离开、重新登录与重入任务组成恢复测试；评估提供明确的重入、重置或客服协助路径，保护任务进度并提示恢复后的影响。",
      "validation": "按任务状态逐步中断再重入，记录是否能回到可继续状态、是否丢失进度以及恢复用时；先确认问题是否仍存在，再决定修复或引导方案。",
      "caveat": "仅2条自述来自同一已知问题帖，未查看图片或复现，不能认为所有任务都受影响；这是一项阻断性风险线索。",
      "evidence_count": 2,
      "source_count": 1,
      "source_urls": [
        "https://www.kurobbs.com/mc/post/1554788184571133952"
      ]
    },
    {
      "category": "character",
      "title": "优先验证战斗镜头恢复、首次大招停顿与打击反馈",
      "observation": "5条不同文本反馈分别涉及攻击后镜头被拉近且不自动恢复（1条）、首次释放大招卡住（1条），以及心月狐的攻击手感或视觉接触感不足（3条）。这些是用户自述的体验线索，可形成复现与测试任务。",
      "recommendation": "针对被提及的角色和技能建立测试场景：检查最远镜头设置在攻击后是否恢复；比较每日或会话首次与后续释放大招；对命中表现、镜头、音效和反馈节奏进行对照测试。先确认问题条件，再确定修改方案。",
      "validation": "记录设备、画质、帧率、角色形态、具体连招和冷启动状态；镜头问题记录触发前后距离；在同一战斗场景比较不同反馈方案，观察命中辨识与操作判断，并访谈实际使用者。",
      "caveat": "5是评论数，不是玩家人数或发生率。镜头、停顿与主观打击感不是同一种根因；当前未取得录像和复现日志，不能直接认定角色机制有缺陷或硬件性能不足。",
      "evidence_count": 5,
      "source_count": 5,
      "source_urls": [
        "https://www.kurobbs.com/mc/post/1551620270882566144",
        "https://www.kurobbs.com/mc/post/1554788184571133952",
